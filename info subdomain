/* Value Stack Hack */
  .value-stack-flex {
    align-items: center;
  }
  .value-stack-wrap {
    background-color: rgb(0,0,0,.4);
  }
  .value-item {
    max-width: 430px;
    display: flex;
    align-items: initial;
	background-color: rgb(0,0,0,0) !important;
  }
  .value-title {
    padding-left: 0;
  }
