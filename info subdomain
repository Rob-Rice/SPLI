		font-size: 18px !important;
		font-weight: 600 !important;
	}
  .value-image {
    text-align: center;
  }
  @media (min-width: 992px) {
    .value-stack-flex {
        flex-flow: row nowrap;
        justify-content: center;
    }
  }
